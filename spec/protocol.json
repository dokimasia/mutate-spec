{
  "record": {
    "name": "dokimi-mutate",
    "version": 2
  },
  "variable": "DOKIMI_MUTATE_MUTANT",
  "instrumented": "DOKIMI_MUTATE_INSTRUMENTED",
  "trace": "DOKIMI_MUTATE_TRACE",
  "prefix": "DOKIMI_MUTATE_",
  "killers": ["first", "all"],
  "coverage": ["tests", "leaves"],
  "verdicts": [
    { "id": "killed", "score": "detected" },
    { "id": "timed-out", "score": "detected" },
    { "id": "exhausted", "score": "detected" },
    { "id": "survived", "score": "undetected" },
    { "id": "no-coverage", "score": "undetected" },
    { "id": "not-viable", "score": "excluded" },
    { "id": "suppressed", "score": "excluded" },
    { "id": "not-selected", "score": "excluded" },
    { "id": "not-run", "score": "excluded" },
    { "id": "error", "score": "excluded" }
  ],
  "errors": [
    "load",
    "annotation-without-reason",
    "stale-annotation",
    "build",
    "control-failed",
    "not-instrumented",
    "ordinary-control-failed",
    "closing-control-failed",
    "changed-files"
  ],
  "limits": {
    "deadline": { "factor": 10, "seconds": 2 },
    "memory": { "factor": 4, "bytes": 536870912 }
  }
}
